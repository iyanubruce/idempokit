{
  "name": "@idempotkit/postgres-adapter",
  "version": "1.0.1",
  "description": "PostgreSQL adapter for IdempotKit – ACID-compliant idempotency with audit trails",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "idempotency",
    "postgres",
    "postgresql",
    "fintech",
    "stripe",
    "payments",
    "pci-dss",
    "cbn",
    "compliance",
    "audit-trail"
  ],
  "author": {
    "name": "Iyanuoluwa Taiwo",
    "email": "iyanuoluwa938@gmail.com",
    "url": "https://github.com/iyanubruce"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyanubruce/idempokit.git",
    "directory": "adapters/postgres"
  },
  "homepage": "https://github.com/iyanubruce/idempokit/tree/main/adapters/postgres",
  "bugs": {
    "url": "https://github.com/iyanubruce/idempokit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pg": "^8.18.0"
  },
  "peerDependencies": {
    "@idempotkit/core": "^1.0.1",
    "typescript": ">=4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.16.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
